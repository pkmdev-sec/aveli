# Secrets must come from the deployment secret manager.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# Set true only after security approves sending the declared page data to both providers.
AVELI_EXTERNAL_DATA_APPROVED=false
AVELI_AUDIT_DIR=/var/log/aveli
AVELI_RUNTIME_ROOT=/tmp/aveli
AVELI_CHROME_PATH=/usr/bin/google-chrome
